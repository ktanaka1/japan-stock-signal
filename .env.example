# --- Cloudflare D1（本番DB。3つ揃って設定するとD1を使用、未設定ならローカルSQLite） ---
# アカウントID: Cloudflareダッシュボード右下 or `wrangler whoami`
CLOUDFLARE_ACCOUNT_ID=
# D1データベースID: ダッシュボードのD1ページ or `wrangler d1 info <db名>`
CLOUDFLARE_D1_DATABASE_ID=
# APIトークン: ダッシュボード > My Profile > API Tokens（権限: Account / D1 / Edit）
CLOUDFLARE_API_TOKEN=

# ローカルSQLiteファイルのパス（D1未設定時の開発用。デフォルト: data/stock_signal.db）
DB_PATH=data/stock_signal.db

# Google Gemini API (aistudio.google.com で取得)
GEMINI_API_KEY=

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# /jobs/collect, /jobs/monitor を外部cronから叩く場合の認証トークン（任意。未設定なら無効）
JOB_TRIGGER_TOKEN=

# EDINET API v2（大量保有報告書アラート用。未設定ならEDINET機能はno-op）
# 取得: https://api.edinet-fsa.go.jp/api/auth/index.aspx?mode=1 でアカウント登録→キー発行（無料）
EDINET_API_KEY=

# 分析レポートメール（安定稼働確認用。REPORT_EMAIL を未設定にすればメールは送られない）
# Gmailの場合: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=送信元アドレス,
#   SMTP_PASSWORD=Googleアカウント > セキュリティ > アプリパスワードで発行した16桁
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL=
